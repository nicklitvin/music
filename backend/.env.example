# CORS origin allowed to call this API. In production, set this to the
# deployed frontend's public URL.
FRONTEND_ORIGIN=http://localhost:5173

# DPI used when rendering PDF pages to PNG in memory.
RENDER_DPI=300

# How far apart oemer's staff net places its 256px image tiles. 256 (no
# overlap) is ~20% faster than oemer's own 128 for the same notes; see "How
# long OMR takes" in the README.
OMR_STAFF_STEP_SIZE=256

# Which note-detection front end feeds position tracking. Default (true) is
# the vendored basic-pitch transcription model; set false to go back to the
# hand-written harmonic-salience estimator. See "Note detection" in the
# README -- it is worth ~18 points of start-anywhere accuracy, so this is a
# revert switch, not a tuning knob.
USE_LEARNED_TRANSCRIPTION=true
